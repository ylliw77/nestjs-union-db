generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  moduleFormat = "cjs" 
}

datasource db {
  provider = "postgresql"
}

model ApprovalHistories {
  id                  String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  branch_id           String           @db.Uuid
  module_id           String           @db.Uuid
  item_id             String           @db.Uuid
  company_position_id String           @db.Uuid
  status              String           @db.VarChar(30)
  remarks             String?
  created_at          DateTime         @default(now()) @db.Timestamp(0)
  created_by          String           @db.VarChar(255)
  sequence_no         Int              @db.SmallInt
  approval_action     String           @db.VarChar(100)
  Branches            Branches         @relation(fields: [branch_id], references: [id])
  CompanyPositions    CompanyPositions @relation(fields: [company_position_id], references: [id])
  Modules             Modules          @relation(fields: [module_id], references: [id])
}

model AutoNumbering {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  numbering_name        String                  @db.VarChar(255)
  module_id             String                  @db.Uuid
  prefix_format         String                  @db.VarChar(255)
  first_sequence        Int                     @db.SmallInt
  padding_length        Int                     @db.SmallInt
  created_at            DateTime                @default(now()) @db.Timestamp(0)
  created_by            String                  @db.VarChar(255)
  updated_at            DateTime?               @default(now()) @db.Timestamp(0)
  updated_by            String?
  deleted_at            DateTime?
  deleted_by            String?
  last_sequence         Int                     @db.SmallInt
  flag_active           OptionFlag              @default(Y)
  prefix_config         String?
  prefix_counter        String?
  additional_code       String?                 @db.VarChar(100)
  flag_default          Boolean?                @default(false)
  Modules               Modules                 @relation(fields: [module_id], references: [id])
  AutoNumberingCounters AutoNumberingCounters[]
  AutoNumberingDetails  AutoNumberingDetails[]
}

model AutoNumberingCounters {
  id                String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  module_id         String        @db.Uuid
  auto_numbering_id String        @db.Uuid
  prefix            String        @db.VarChar(300)
  last_sequence     Int           @db.SmallInt
  created_at        DateTime      @default(now()) @db.Timestamp(0)
  created_by        String        @db.VarChar(255)
  updated_at        DateTime?     @default(now()) @db.Timestamp(0)
  updated_by        String?
  deleted_at        DateTime?
  deleted_by        String?
  AutoNumbering     AutoNumbering @relation(fields: [auto_numbering_id], references: [id])
}

model AutoNumberingDetails {
  id                 String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  auto_numbering_id  String        @db.Uuid
  prefix_name        String        @db.VarChar(255)
  prefix_value       String        @db.VarChar(255)
  separator          String?       @db.VarChar(10)
  order_no           Int           @db.SmallInt
  created_at         DateTime      @default(now()) @db.Timestamp(0)
  created_by         String        @db.VarChar(255)
  updated_at         DateTime?     @default(now()) @db.Timestamp(0)
  updated_by         String?
  deleted_at         DateTime?
  deleted_by         String?
  module_name        String?       @db.VarChar(300)
  reference_field    String?       @db.VarChar(300)
  flag_counter_reset OptionFlag    @default(N)
  AutoNumbering      AutoNumbering @relation(fields: [auto_numbering_id], references: [id])
}

model BankMappings {
